{
  "name": "@arrival-space/cli",
  "version": "1.1.1",
  "description": "Arrival.Space CLI — build and share 3D spaces (Gaussian splats, 3D models, plugins) as local files: pull / push / validate",
  "bin": {
    "arrival": "index.js"
  },
  "files": [
    "index.js",
    "lib/",
    "!lib/**/*.test.js"
  ],
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "arrival.space",
    "cli",
    "space-as-code",
    "gaussian-splatting",
    "3dgs",
    "splat",
    "3d",
    "webxr",
    "playcanvas",
    "mcp",
    "ai-agent"
  ],
  "homepage": "https://arrival.space",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arrival-space/arrival-plugins.git",
    "directory": "tools/arrival-cli"
  },
  "bugs": "https://github.com/arrival-space/arrival-plugins/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "commander": "^12.1.0",
    "diff": "^7.0.0"
  }
}
